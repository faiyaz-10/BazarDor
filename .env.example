# Application URL (set to the deployed Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# MongoDB Atlas (recommended for deployment)
# Get this URI from Atlas > Database > Connect > Drivers, then replace the placeholders.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/BazarDor?retryWrites=true&w=majority
MONGODB_DB=BazarDor
# Atlas uses a replica set; keep false. Set true only for a standalone local MongoDB server.
MONGODB_DISABLE_TRANSACTIONS=false

# OAuth provider credentials (optional; configure callback URLs in the provider dashboards)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Product API
BAZARDOR_API_BASE=https://api.api-store.workers.dev/api/bazardor
